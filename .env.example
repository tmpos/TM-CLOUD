APP_NAME=TMPBase
APP_URL=http://localhost:8000
APP_ENV=production
APP_DEBUG=false
SESSION_SECURE=false
MAX_UPLOAD_MB=10
APK_MAX_UPLOAD_MB=250
SYSTEM_APP_MAX_UPLOAD_MB=500
PROJECT_STORAGE_MAX_MB=1024
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=300
BACKUP_RETENTION_COUNT=20
BACKUP_RETENTION_DAYS=90
BACKUP_MAX_MB_PER_PROJECT=5120
# Recipient for automated admin alerts (storage quota, stale/failed backups)
ALERT_ADMIN_EMAIL=
# Percent of project storage quota that triggers an alert
ALERT_STORAGE_THRESHOLD_PERCENT=90
# Days since the last backup before it is considered stale
ALERT_BACKUP_STALE_DAYS=2
# Hours to wait before re-sending the same alert for the same project
ALERT_COOLDOWN_HOURS=24
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=TMPBase
MAIL_REPLY_TO=
MAIL_MAX_ATTEMPTS=5
REALTIME_ENABLED=true
REALTIME_WS_URL=ws://127.0.0.1:8080
REALTIME_WS_PORT=8080
REALTIME_EVENT_PORT=8081
